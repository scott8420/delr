# commit. NOT `data/` wholesale -- brokers.json and pagerules.json are
# download-only assets and belong in git. These are what the RUNNING app
# writes, and egress.json holds naked_exit: this machine's address with the
# tunnel DOWN.
data/egress.json
data/cases.json
data/*.log
